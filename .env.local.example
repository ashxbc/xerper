# Cookies from up to three logged-in burner X sessions, used round-robin so
# the app can sustain ~3 req/sec (1 req/sec per burner) instead of one
# account's worth of rate limit.
#
# For each burner: log in at x.com in a browser, then:
#   DevTools (F12) -> Application -> Storage -> Cookies -> https://x.com
# and copy these two values.
#
# Cookies rather than a password on purpose: X's scripted login flow triggers
# email/phone challenges and is the fastest way to get a burner locked.
# They last weeks - re-paste when you start seeing auth errors.
#
# Only X_AUTH_TOKEN_1/X_CT0_1 is required; add _2 and _3 to grow the pool.
# A lone unindexed X_AUTH_TOKEN/X_CT0 pair also still works as a single burner.
X_AUTH_TOKEN_1=
X_CT0_1=
X_AUTH_TOKEN_2=
X_CT0_2=
X_AUTH_TOKEN_3=
X_CT0_3=

# Optional: path to the Python running the fetcher / crawl4ai bridge
# (defaults to "python"). The Telegram bot uses crawl4ai for text extraction:
#   pip install -U crawl4ai && crawl4ai-setup
PYTHON_BIN=python

# --- Backend NFT discovery scan (api/discovery) -----------------------------
# Not linked from the UI - runs a fixed set of search queries looking for
# low-follower accounts announcing new mints, then classifies each candidate
# with Groq.
#
# Uses its own dedicated 4th burner, entirely separate from the X_AUTH_TOKEN_1
# .._3 pool above, so a scan never competes with a real user's request for
# burner budget. Cookies are pulled from this account's browser session the
# same way as the numbered burners above.
X_DISCOVERY_AUTH_TOKEN=
X_DISCOVERY_CT0=

# Optional: require ?secret= (or X-Discovery-Secret header) to call the
# route. Leave blank while testing locally; set this before deploying so the
# scan can't be triggered by anyone who finds the URL.
DISCOVERY_SECRET=

# Groq classifies each low-follower candidate (handle + bio + most recent
# tweet only) as a real NFT project or not. Get a key at
# https://console.groq.com
GROQ_API_KEY=

# Optional: follower ceiling a candidate must be under before it's even sent
# to Groq (defaults to 500 - this is the "still pre-hype" signal)
DISCOVERY_MAX_FOLLOWERS=500

# Optional: pages fetched per query (defaults to 1 - this is a wide scan
# across many queries, not a deep pull on any single one)
DISCOVERY_PAGES=1

# Optional: tweets fetched per page/query (defaults to 20)
DISCOVERY_PAGE_SIZE=20

# Optional: max unique candidate handles evaluated per scan (defaults to 20).
# Each one costs an X profile lookup, maybe a tweet fetch, and a Groq call,
# all paced at 1 req/sec on the single discovery account - keep this low
# enough to fit inside your host's request timeout.
DISCOVERY_MAX_CANDIDATES=20

# --- Telegram bot (scripts/telegram-bot.ts) ---------------------------------
# Token from @BotFather. The bot is the project-listing workflow: paste a
# project link/tweet/text, it extracts name / task / details / steps via Groq,
# lets you edit them with inline buttons, asks for the project's X handle
# (fetching its PFP), and on confirmation inserts the project into Supabase
# (status 'added'), which makes it appear on the site. In-flight drafts are
# kept in .telegram-bot-state.json so they survive restarts.
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated chat IDs allowed to use the bot. When unset,
# anyone who finds the bot can use it (and spend your Groq quota).
TELEGRAM_ALLOWED_IDS=

# Optional: dedicated Groq key for the bot. When set, it wins over
# GROQ_API_KEY above.
TELEGRAM_GROQ_API_KEY=
